# syntax=docker/dockerfile:1
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000 \
    WORKDIR=/app

WORKDIR ${WORKDIR}

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy sources
COPY shared.py ./
COPY agents ./agents
COPY app_main.py ./

# Default to main Orchestrator
EXPOSE ${PORT}
CMD ["bash","-lc","uvicorn app_main:app --host 0.0.0.0 --port ${PORT}"]

# Agent Role
ENV AGENT_ROLE="What-If Calculator"
